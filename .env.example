# KisanSetu Environment Variables

# Server Configuration
PORT=5000
FLASK_ENV=development
SECRET_KEY=kisansetu-super-secret-key-change-in-production-2026
JWT_SECRET=kisansetu-jwt-secret-token-key-sih-2026

# Firebase Configuration (Optional - falls back to persistent local storage if empty)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CREDENTIALS_PATH=

# Payment Gateway Keys (Optional - runs in high-fidelity simulation mode if empty)
RAZORPAY_KEY_ID=rzp_test_kisansetu123
RAZORPAY_KEY_SECRET=secret_kisansetu_test
STRIPE_PUBLISHABLE_KEY=pk_test_kisansetu123
STRIPE_SECRET_KEY=sk_test_kisansetu123

# Maps & Routing
GOOGLE_MAPS_API_KEY=
USE_OPENSTREETMAP=true

# Twilio IVR & SMS (Optional for Webhook Testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Security Enhancements
# Set to 'true' in production to enforce strict HTTPS and CSP headers
ENFORCE_SSL=false
